# intervals.icu: Settings → Developer Settings → API key. Athlete ID is shown there too (e.g. i123456).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Recent 5K race time (m:ss.s); training paces are derived from it.
ATHLETE_5K_TIME=

# Coaching model. "cli" uses your local `claude` login (free with Pro; local testing only).
COACH_BACKEND=cli
COACH_MODEL=claude-opus-5

# Later milestones
ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_RUN_LOG=
DISCORD_WEBHOOK_WEEKLY_COACH=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
