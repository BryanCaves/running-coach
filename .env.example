# intervals.icu: Settings → Developer Settings → API key. Athlete ID is shown there too (e.g. i123456).
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=

# Recent 5K race time (m:ss.s); training paces are derived from it.
ATHLETE_5K_TIME=
# Dates (week boundaries, "today") use this zone.
ATHLETE_TZ=America/Los_Angeles

# Coaching backend: "cli" (default) uses your `claude` login on a Claude plan.
# "gemini" uses Gemini's API; its free tier lets Google use and human-review your data (see README).
COACH_BACKEND=cli
# Optional model override. Defaults: claude-opus-5 (cli), gemini-3.8-flash (gemini).
COACH_MODEL=
GEMINI_API_KEY=

# Later milestones
ANTHROPIC_API_KEY=
DISCORD_WEBHOOK_RUN_LOG=
DISCORD_WEBHOOK_WEEKLY_COACH=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
